--- !u!114 &462314194
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 462314193}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7cc977de85d3a9f4a9874af42ab73c88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sequences:
  - sequenceName: Little Kraken
    startTime: 87
    lines:
    - speaker: 1
      speakerName: TheLittleKraken
      text: 'Your powers are overflowing.

        I''m concerned that will be harmful
        for us.'
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 8961046758033588176, guid: 8a74f49ecd0befb4288e51665aa63352, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: 'No, I don''t mean to do that.

        I just want to go back to where
        I left...'
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: TheLittleKraken
      text: 'I don''t believe that word.

        At lease look at your current power
        level.'
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 8961046758033588176, guid: 8a74f49ecd0befb4288e51665aa63352, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: TheLittleKraken
      text: Are you sure that your power won't cause any problem to those innocents?
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 8961046758033588176, guid: 8a74f49ecd0befb4288e51665aa63352, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: '...

        Someone I know told me that my power can be control.'
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: At lease I have to go there.
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: TheLittleKraken
      text: 'No. I am not allowed.

        You threatened the world of sea.

        It
        is my duty to protect the sea.'
