  m_Script: {fileID: 11500000, guid: bb1cc084f9b67614097d36ecd4c15fae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  stageSpawner: {fileID: 2147344893}
  timeline:
  - speakerId: Stage04
    text: 'Stage04

      ----------------

      The Ocean'
    startTime: 1
    liveTime: 2
    endStyle: 1
    nextTextDelay: 3
  - speakerId: Lukari
    text: I... don't think I want to stay near water.
    startTime: 1
    liveTime: 2
    endStyle: 0
    nextTextDelay: 2
  - speakerId: Lukari
    text: Fishy a lot...
    startTime: 1
    liveTime: 2
    endStyle: 0
    nextTextDelay: 2
  - speakerId: Lukari
    text: I'm afraid my fire will got-
    startTime: 1
    liveTime: 1
    endStyle: 0
    nextTextDelay: 2
  - speakerId: Lukari
    text: ...extinguished from these little fish...
    startTime: 1
    liveTime: 2
    endStyle: 0
    nextTextDelay: 2
  conditionalGroups:
  - groupName: Boss
    targetBoss: {fileID: 0}
    condition: 0
    entries:
    - speakerId: Lukari
      text: Maybe Not.
      startTime: 0
      liveTime: 2
      endStyle: 0
      nextTextDelay: 2
    - speakerId: Lukari
      text: What is that tornado???
      startTime: 0
      liveTime: 2
      endStyle: 0
      nextTextDelay: 0
