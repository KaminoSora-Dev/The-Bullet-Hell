  sequences:
  - sequenceName: Boss Found
    startTime: 130
    lines:
    - speaker: 0
      speakerName: Lukari
      text: Where am I?
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 21300000, guid: 29099722375552244b002c7010285d9e, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: ???
      text: It's my space. Welcome to my tutorial stage!
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 21300000, guid: fc305e3a106c75f42ac9557b6d8ff44f, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: What are you?
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 21300000, guid: 29099722375552244b002c7010285d9e, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: Tutorial Boss
      text: 'I am just a tutorial boss In here.

        You already passed my stage.'
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 21300000, guid: fc305e3a106c75f42ac9557b6d8ff44f, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: Huh? What is that?
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 21300000, guid: 29099722375552244b002c7010285d9e, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: Tutorial Boss
      text: 'Thinking like you''re in the game.

        You just played my stage
        till the end.'
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 21300000, guid: fc305e3a106c75f42ac9557b6d8ff44f, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: This is kinda odd...
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 21300000, guid: 29099722375552244b002c7010285d9e, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: Tutorial Boss
      text: It's nothing. Right?
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 21300000, guid: fc305e3a106c75f42ac9557b6d8ff44f, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: Let me ask... Can I go out from here?
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 21300000, guid: 29099722375552244b002c7010285d9e, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: Tutorial Boss
      text: No...
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 21300000, guid: 12ff82bec6a8e8940a15ac750d25f06c, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: Tutorial Boss
      text: Nah. You will never!
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 21300000, guid: 9396ca48be1b15642bdc67a234253de5, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: Tutorial Boss
      text: I won't allow you to go out from here!
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 21300000, guid: 12ff82bec6a8e8940a15ac750d25f06c, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
