    - speaker: 0
      speakerName: Lukari
      text: ???
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: The Glitch Star
      text: '@#$*&^Help@#($&%^(%@Us...4234289472308'
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 3737755799073572649, guid: b9978af1fc575d04fa967b2d69d1157b, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: You're... A Star?
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: The Glitch Star
      text: '*$&%#*%@&%*!Release#(@&%*&$!(*Me*#&@^$*@&%'
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 338778975776115725, guid: d098f1b649154ee40b8d8bbcbded48e8, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: ...
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: I'm sorry to hear that...
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: 'You shouldn''t be like that...

        I shouldn''t... I just want
        to get out of here...'
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 1
      speakerName: The Glitch Star
      text: '@#$*^%*^%!Iamcontrolling#@($*%^&(!thegate...*@#$&%

        #$*^&%*!Releaseme@*&#^%*&%AndItsPower

        @#$(^#@*%$thegate@#$&^*%willopen#&@$@*^$(*'
      showLeftPortrait: 0
      showRightPortrait: 1
      portraitSprite: {fileID: 6216768912127411068, guid: 402abc5255b31d4488800d9c19ed0be5, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
    - speaker: 0
      speakerName: Lukari
      text: '...

        Okay then... I hope you will reborn as something better.'
      showLeftPortrait: 1
      showRightPortrait: 0
      portraitSprite: {fileID: 7497447210740581395, guid: 7a0b5885d12f85f499d4c7b75de0fdc3, type: 3}
      useAnimatorPortrait: 0
      animatorTriggerName: 
      typeSfxOverride: {fileID: 0}
